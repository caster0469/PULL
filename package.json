{
  "name": "pull-downloader",
  "version": "1.0.0",
  "description": "PULL — a quiet, cross-platform video and audio downloader",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist-electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {"@vitejs/plugin-react":"latest","vite":"latest","typescript":"latest","electron":"latest","electron-builder":"latest","react":"latest","react-dom":"latest","lucide-react":"latest"},
  "devDependencies": {"@types/node":"latest","@types/react":"latest","@types/react-dom":"latest","concurrently":"latest","cross-env":"latest","wait-on":"latest"},
  "build": {
    "appId": "com.pull.downloader", "productName": "PULL", "artifactName": "PULL-${version}-${os}-${arch}.${ext}",
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "extraResources": [{"from":"resources/binaries","to":"binaries","filter":["**/*"]}],
    "mac": {"target":"dmg","category":"public.app-category.utilities"},
    "win": {"target":"nsis"}, "linux": {"target":"deb","category":"Utility"}
  }
}
