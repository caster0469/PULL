{
  "name": "pull-downloader",
  "version": "1.0.0",
  "description": "PULL — a quiet, cross-platform video and audio downloader",
  "main": "dist-electron/electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently --kill-others --names renderer,electron-ts,electron \"npm:dev:renderer\" \"npm:dev:electron:watch\" \"npm:dev:electron:start\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:start": "wait-on http-get://127.0.0.1:5173 dist-electron/electron/main/index.js dist-electron/electron/preload/index.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173/ electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "package": "npm run stage:binaries && npm run build && electron-builder",
    "package:mac": "npm run stage:binaries && npm run build && electron-builder --mac",
    "package:win": "npm run stage:binaries && npm run build && electron-builder --win",
    "package:linux": "npm run stage:binaries && npm run build && electron-builder --linux",
    "stage:binaries": "node scripts/stage-binaries.mjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.pull.downloader",
    "productName": "PULL",
    "artifactName": "PULL-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/binaries",
        "to": "binaries",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb",
      "category": "Utility"
    }
  }
}
